# ---------------------------------------------------
# Python & Environment
# ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# ---------------------------------------------------
# Datasets & Imagery (CRITICAL: Do not commit data)
# ---------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
base_paper/data/*
!base_paper/data/.gitkeep
*.mp4
*.avi
*.jpg
*.png

